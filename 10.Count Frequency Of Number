/**
Count Frequency Of element

(i)Optimal : O(n) S.C : 0(1)
--> Using unordered_Map

**/
# include <bits/stdc++.h>
using namespace std;

vector<vector<int>> freq (vector<int> v)
{
   unordered_map<int,int> mp;
    for (auto i: v)
        mp[i]++;
    vector<vector<int>>res;
    for (auto i: mp)
        {
            res.push_back({i.first,i.second});
        }
    return res;
}
