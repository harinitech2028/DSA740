//ArmStrong Number
// 153 = 1^(no_of_digits) + 5^(no_of_digits)+ 3^(no_of_digits)

# include <iostream>
# include <bits/stdc++.h>
using namespace std;

bool armstrong (int n)
{
    int ori = n;
    int digits = log10(n) + 1;
    int sum = 0;

    while (n!=0)
        {
            int last = n%10;
            sum += pow(last,digits);
            n= n/10;
            
        }
    if(sum == ori)
        return true;
    return false;
}

int main ()
{
    int n = 153;
    bool ans = armstrong(n);
    if(ans)
        cout<<"Armstong";
    else
        cout<<"Not armstrong";
}
