A number is called a perfect number if the sum of all its positive divisors, excluding the number itself, equals the number.

(i) Brute Force : T.C: O(n) || S.C: O(1)

bool perfect (int n)
{
    int sum = 1;
    for (int i  = 2;i<n;i++)
        {
            if (n%i == 0)
            {
                sum+=i;
            }
         
        }
   return sum ==n;
}
------------------------------------------------
(ii) Optimal : O(sqrt(n)) || S.C: O(1)

class Solution {
  public:
    bool isPerfect(int n) {
        // code here
        int sum = 1;
        for (int i = 2;i*i<n;i++)
        {
            if (n%i ==0)
            {
                if (i*i <=n)
                {
                    sum = sum + i + n/i;
                }
                else
                sum= sum + i;
            }
        }
        return sum==n;
    }
};
