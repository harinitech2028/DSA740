/**
(i)Selection Sort: T,C: O(n2) || S.C: O(1)
Approach:
--> Choose mini from rest [excluding first]
--> swap with first element

again : find min from  rest --> swap with 2 nd element 
and so on



**/
# include <bits/stdc++.h>
using namespace std;

void sort (vector<int> &v)
{
    int n = v.size();
    int mini_idx ,i,j;
    mini_idx = i;// index holding minimum element

    for ( i   = 0;i<n;i++)
        {
            for ( j = i+ 1 ;j<n ;j++)
                {
                    if (v[j] < v[mini_idx])
                    {
                        mini_idx= j;
                    }
                }
              swap (v[mini_idx],v[i]);
          
        }
}
