
--> given array
--> all element repeat twice except one
--> return that element (first elemnt that occurs once )



(i) Brute Force: T.C: O(n2) || S.C: O(1)

class Solution {
  public:
    int firstNonRepeating(vector<int>& arr) {
        // code here
        for (int i  = 0;i<arr.size();i++)
        {
            bool isfound = false;
            
            for (int j =0;j<arr.size();j++)
            {
                if(i!=j &&arr[i] == arr[j])
                {
                isfound = true;
                break;
                }
            }
            if(!isfound)
            return arr[i];
        }
        return -1;
    }
};
------------------------------------------------
(ii) Optimal : O(n) || S.C: O(n)

class Solution {
  public:
    int firstNonRepeating(vector<int>& arr) {
        // code here
        unordered_map<int,int> mp;
        
        for (auto i : arr)
        mp[i]++;
        
        for (int i =0; i<arr.size();i++)
        {
             if (mp[arr[i]] == 1)
             return arr[i];
        }
        
        return 0;
    }
};

