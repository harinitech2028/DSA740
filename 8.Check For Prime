//Check For prime 
// Basic Idea : Prime no. 2 Factors ( 1 and itself)
//Optimal
// T.C: O(sqrt(n))
//S.C: O(1)
# include <bits/stdc++.h>
using namespace std;

bool isPrime (int n)
{
    int c =0;
  for (int i  = 1;i*i<=n;i++)
      {
          if (n%i == 0)
          {
              c++;

              if(n/i != i)
                  c++;
          }
      }
    if (c ==2)
        return true;
    return false;
}
int main ()
{
    int n = 6;
    bool ans = isPrime(n);
    if(ans)
        cout<<"Prime"<<" ";
    else
        cout<<"Not Prime";
}

