//(iv) Prime no. are of form 6k+ 1 or 6k - 1
//i.e 5,6,7 [ 5 and 7]
// T.C: O(sqrt(n))
//S.C: O(1)
# include <bits/stdc++.h>
using namespace std;

bool isPrime (int n)
{
    
  
          if(n<=1 )
              return false;
          if (n ==2 || n == 3)
              return true;

          if(n%2 ==0 || n%3 ==0)
              return false;
            for (int i = 5; i*i <=n;i= i + 6)
                {
                    if (n%i == 0 || (n% (i + 2)) ==0)
                        return false;
                }
