// Print all Divisors
// Brute Force : 
//T.c: O(n)
//S.C: O(1)

# include <iostream>
# include <bits/stdc++.h>
using namespace std;

void  divisors (int n)
{
    for (int i =1;i<=n;i++)
        {
            if(n%i ==0)
                cout<<i<<" ";
        }
        
}
int main ()
{
    int n = 6;
    divisors(n);
}
