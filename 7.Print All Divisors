// Print all Divisors
// Optimal
//T.c: O(sqrt(n))
//S.C: O(1)

# include <iostream>
# include <bits/stdc++.h>
using namespace std;

void  divisors (int n)
{
    for (int i =1;i*i<=n;i++)
        {
            if(n%i ==0)
            {
                cout<<i<<" ";
                if(n/i !=i)
                    cout<<n/i<<" ";
            }
        }
        
}
int main ()
{
    int n = 6;
    divisors(n);
}
