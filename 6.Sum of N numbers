//Brute Force 
//T.C: 0(n)
//S.C: O(1)

#include <iostream>
using namespace std;

int main() {
    int n;
    cin >> n;

    // code here
    int sum = 0;
    for (int i= 0;i<=n;i++)
     sum+=i;
    cout<<sum;

    return 0;
}
