//Optimal Approach
// T.C: 0(1) S.C: O(1)
#include <iostream>
using namespace std;

int main() {
    int n;
    cin >> n;

    // code here
    int sum =0;
    sum = (n* (n + 1) )/2;
    cout<<sum;

    return 0;
}
