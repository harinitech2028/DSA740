/**
Maximum Frequency element in Array
    (i) Optimal Approach : O(n)
    unordered_Map
***/
# include <bits/stdc++.h>
using namespace std;

int freq (vector<int> v)
{
    int n  = v.size();
    unordered_map<int,int>mp;
    for (auto i:v)
        mp[i]++;

    int maxi = INT_MIN, ele;

    for (auto i: mp)
        {
            if (i.second>maxi)
            {
                maxi = i.second;
                ele = i.first;
            }
        }
    return ele;
}
