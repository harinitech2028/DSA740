/**
Maximum Frequency element in Array
(i) Brute Force : O(n2)
    two loops
***/
# include <bits/stdc++.h>
using namespace std;

int freq (vector<int> v)
{
    int n  = v.size();
    vector<bool> visited (n,false);
    int maxi = INT_MIN;
    int ele;

    for (int i = 0 ; i<n;i++)
        {
            if(visited[i])
                continue;

            int c =1;
            for (int j = i + 1;j<n;j++ )
                {
                if(v[i] == v[j])
                {
                    c++;
                    visited[j] = true;
                    
                }
                    if (c> maxi)
                    {
                        maxi = c;
                        ele  = v[i];
                    }
                }
        }
    return ele;
}
