//Fabonacci Of Number [recurssion]
//Fibo : n = 5 : 0,1,1,2,3,5
// T.C: O(n)
//S.C: O(n) // recurssion call stack

# include <bits/stdc++.h>
using namespace std;

void fibo (int n)
{
   int n1 = 0, n2 = 1;
    int i = 1;

    while (i<=n)
        {
                   cout<<n1<<" ";
          int  n3 = n1+ n2;
     
          
            n1 = n2;
            n2 = n3;
            i++;
        }
}

int main ()
{
    int n = 5;
     fibo (n);
    
}
