//Fabonacci Of Number [recurssion]
//Fibo : n = 5 : 0,1,1,2,3,5
// T.C: O(n)
//S.C: O(n) // recurssion call stack

# include <bits/stdc++.h>
using namespace std;

int fibo (int n)
{
    if ( n== 0)
        return 0;
  if (n==1)
      return 1;
    return fibo(n- 2) + fibo( n -1);
}

int main ()
{
    int n = 5;
    int ans = fibo (n);
    cout<<ans;
}
