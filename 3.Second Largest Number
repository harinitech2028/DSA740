/**
Second Largest: 
Optimal:
T.C: O(n) || S.C: O(1)

#include <bits/stdc++.h>
using namespace std;

int find_second_largest(vector<int>& arr) {
    // write your solution below
    int n = arr.size();

    int maxi = INT_MIN, sec_large = INT_MIN;

    for (int i =0;i<n;i++)
    {
        if (arr[i] >maxi)
        {
            sec_large = maxi;
            maxi = arr[i];
        }
        else if (arr[i] >sec_large &&  arr[i] < maxi)
        {
            sec_large = arr[i];
        }
    }
return sec_large;
    
}
