// GCD /HCF
//Brute Force :  T.C : o(n)
//S.C: O(1)

# include <bits/stdc++.h>
using namespace std;

int gcd (int n,int n2)
{
    int maxi = 1;
    for (int i =min(n,n2);i>1;i--)
        {
            if(n%i ==0 && n2%i ==0 )
                maxi = max(maxi,i);
        }
    return maxi;
}

int main ()
{
    int n=6 ,n2 = 12;
    int ans = gcd(n,n2);
    cout<<ans;
}
