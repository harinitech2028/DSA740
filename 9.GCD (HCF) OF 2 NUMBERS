// GCD /HCF: [ECUCLIDEAN]
//Brute Force :  T.C : o(n)
//S.C: O(1)

# include <bits/stdc++.h>
using namespace std;

int gcd (int n,int n2)
{
  while (n!=0)
      {
          int rem = n2%n;
          n2 = n;
          n = rem;
      }
    return n2;
}

int main ()
{
    int n=6 ,n2 = 12;
    int ans = gcd(n,n2);
    cout<<ans;
}
