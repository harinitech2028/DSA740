
(i) Reverse an Array :
--> Optimal Approach:
T.C: O(n) || S.C: O(1)
#include <bits/stdc++.h>
using namespace std;

void reverse_array(vector<int>& arr) {
    // write your solution below
    int n = arr.size();
    int l = 0, h = n - 1;
    while (l<h)
    {
        swap(arr[l],arr[h]);
        l++;
        h--;
    }
}
