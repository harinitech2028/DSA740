// Count Digits of A Number:
// Brute force : 0(log(n))
//S.C: O(1)

# include <bits/stdc++.h>
using namespace std;
int count (int n)
{
    int c = 0;
    while (n!=0)
        {
            c++;
            n=n/10;
        }
    return c;
}
int main ()
{
    int n = 1234;
    int ans = count(n);
    cout<<ans;
}
