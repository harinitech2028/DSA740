//Factorial Of Number [recurssion]
//Factorial : 5! = 5*4*3*2*1
// T.C: O(n)
//S.C: O(n) // recurssion call stack

# include <bits/stdc++.h>
using namespace std;

int fact (int n)
{
  if (n<=1)
      return 1;
    return n * fact( n - 1);
}

int main ()
{
    int n = 5;
    int ans = fact (n);
    cout<<ans;
}

--------------------------------------------------------------------------------------------------------------------------------
-----------------------------------------------------------------------------------------------------------------------------
//Factorial Of Number
// T.C: O(n)
//S.C: O(1)

# include <bits/stdc++.h>
using namespace std;

int fact (int n)
{
    int ans = 1;
    for (int i = 1; i<=n;i++)
        {
            ans = ans* i;
        }
    return ans;
}

int main ()
{
    int n = 5;
    int ans = fact (n);
    cout<<ans;
}
