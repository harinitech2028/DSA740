# include <bits/stdc++.h>
using namespace std;

int count (int n)
{
    int c = 0;
    while (n!=0)
        {
            int last = n%10;
            if(last == 0)
                c++;
            n=n/10;
            
        }
    return c;
}

int main ()
{
    int n = 102030;
    int ans = count(n);
    cout<<ans;
}
